{#
  Renders a dialog to edit history information

  Variables:
  * history - The history being edited.
#}

<div id="history-dialog" class="backdrop">
  <div class="edit-history dialog">
    <strong>Edit History Information</strong>
    <div id="history-errors" class="hidden"></div>
    <form method="post" {{ htmx_attrs ? htmx_attrs|raw : ''}}>
      <label for="description">Seed</label>
      <br>
      <textarea name="description" rows="10">{{ history.description }}</textarea>
      <br><br>
      <label for="focus">Focus</label>
      <br>
      <input type="text" value="{{ history.focus }}">
    </form>
  </div>
</div>
